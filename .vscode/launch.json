{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug HTTP (go run)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/cmd/serve",
      "args": ["--config=${workspaceFolder}/configs/config.yml"],
      "env": {
        "GO111MODULE": "on"
      }
    },

    {
      "name": "Run HTTP (Bazel)",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/scripts/run.sh",
      "args": ["serve", "http", "--", "--config=configs/config.yml"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Launch Package",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${fileDirname}"
    },
    {
      "name": "Attach to Process",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": "${command:pickProcess}"
    }
  ]
}
